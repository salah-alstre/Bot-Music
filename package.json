{
  "name": "sonaris-music-bot",
  "version": "1.0.0",
  "description": "Sonaris - a premium Discord music bot powered by Lavalink v4.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "deploy:commands": "node --disable-warning=ExperimentalWarning dist/scripts/deployCommands.js",
    "smoke": "node --disable-warning=ExperimentalWarning dist/scripts/smokeLavalink.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "node scripts/verify-project.mjs",
    "check:env": "node --disable-warning=ExperimentalWarning dist/scripts/checkEnv.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "lavalink-client": "^2.11.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
