# Sonaris configuration. Copy this file to ".env" (scripts\setup-windows.ps1 does it for you)
# and fill in the values. Never commit ".env" and never share it: it contains secrets.

# --- Discord (required) ----------------------------------------------------------------------
# Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-goes-here
# Developer Portal -> your application -> General Information -> Application ID
DISCORD_CLIENT_ID=your-application-id
# Optional. Set a server ID while developing so slash commands update instantly in that server.
# Leave empty in production to register commands globally.
DISCORD_GUILD_ID=

# --- Lavalink (audio server) -----------------------------------------------------------------
# The Windows setup script generates a strong password for you. Both the bot and Lavalink read it.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=your-long-random-password
LAVALINK_SECURE=false
# Maximum Java heap for Lavalink (used by the Windows service). 1G is plenty for small and medium bots.
LAVALINK_MEMORY=1G

# --- Spotify links (optional, used by Lavalink) ----------------------------------------------
# Spotify links and playlists are resolved with Spotify metadata and played from YouTube/SoundCloud.
# Create an app at https://developer.spotify.com/dashboard, then paste its credentials and set
# SPOTIFY_ENABLED=true.
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=US

# --- YouTube sign-in workaround (optional, used by Lavalink) ---------------------------------
# YouTube sometimes asks servers to "sign in to confirm you're not a bot". If that happens,
# see docs/TROUBLESHOOTING.md ("YouTube asks to sign in") before enabling this. Use a burner account.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- Bot behaviour ---------------------------------------------------------------------------
# Which source plain-text searches use first: ytmsearch (YouTube Music), ytsearch (YouTube), scsearch (SoundCloud)
DEFAULT_SEARCH_SOURCE=ytmsearch
# Lets users type song names in the server's request channel (/setup controller messages:true).
# Requires the privileged "Message Content Intent" to be enabled in the Developer Portal (Bot tab).
MESSAGE_REQUESTS_ENABLED=false

# --- Storage and logs ------------------------------------------------------------------------
DATABASE_PATH=./data/sonaris.db
LOG_DIR=./logs
LOG_LEVEL=info
NODE_ENV=production

# --- About command (optional) ----------------------------------------------------------------
BOT_DEVELOPER=Your Name
BOT_SUPPORT_URL=
BOT_WEBSITE_URL=
BOT_GITHUB_URL=
